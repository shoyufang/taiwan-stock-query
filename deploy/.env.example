# 複製成 deploy/.env 後填值（deploy/.env 不進 git）
# 網站只綁定這個 IP（home server 的 Tailscale IP），不對區網、公網開放
BIND_IP=100.100.245.93

# 永豐金 Shioaji（即時行情）。只用行情、不下單、不需 CA 憑證
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
# true＝模擬環境；若模擬環境推送的不是真實行情，改 false
SHIOAJI_SIMULATION=true
# 1＝不論時段都登入（僅供休市時測試登入與訂閱流程，測完改回 0）
QUOTE_FORCE_SESSION=0

# FinMind（選填，提高查詢額度）
FINMIND_TOKEN=

# Telegram 警示通知（選填；用 deploy/set-telegram.sh 設定，不要手打）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
