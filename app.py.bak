                            "tab": "帳務",
                            "title": "期貨保證金",
                            "params": {"type": "margin"}
                        })
                    else:
                        st.info("無保證金資料")
                except Exception as e:
                    st.error(f"查詢失敗: {str(e)}")

    elif query_type == "交割款明細":
        st.subheader("💸 交割款明細")
        st.info("查詢交割款繳交情況")
        if st.button("查詢交割", key="settlements"):
            with st.spinner("查詢中..."):
                try:
                    result = qw.query_settlements()
                    st.session_state.current_result = result
                    if not result.empty:
                        display_result(result, "交割款明細")
                        add_history({
                            "tab": "帳務",
