# ══════════════════════════════════════════════════════════
# 全局預加載管理器（緩存）
# ══════════════════════════════════════════════════════════

@st.cache_resource
def get_preload_manager():
    """初始化並啟動預加載管理器"""
    import asyncio
    pm = PreloadManager()
    main_logger.info("初始化預加載管理器...")

    try:
        # 嘗試執行預加載
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
        loop.run_until_complete(pm.run_all_preloads())
    except Exception as e:
        main_logger.warning(f"預加載執行出錯: {str(e)}")

    return pm

# 初始化預加載管理器
preload_manager = get_preload_manager()

# ══════════════════════════════════════════════════════════
# 初始化 Session State
