def render_finmind():
    """FinMind 查詢"""
    main_logger.info("渲染 FinMind Tab")
    category = st.selectbox(
        "選擇資料類型",
        [
            "籌碼面",
            "基本面"
        ]
    )

    if category == "籌碼面":
        query_type = st.selectbox(
            "選擇查詢",
            [
                "三大法人明細",
                "當沖交易量",
                "融資融券餘額",
                "外資持股比例",
                "借券成交"
            ]
        )
        code = code_input_section()
        start_date, end_date = date_input_section()

        if query_type == "三大法人明細":
            if st.button("查詢", key="institutional"):
                if code:
