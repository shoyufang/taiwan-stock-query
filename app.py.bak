def render_taistock_market():
    """台股市場查詢"""
    main_logger.info("渲染台股市場 Tab")
    query_type = st.selectbox(
        "選擇查詢類型",
        [
            "漲幅排行",
            "跌幅排行",
            "成交量排行",
            "成交金額排行",
            "個股即時快照",
            "個股日K",
            "逐筆成交"
        ]
    )

    if query_type == "漲幅排行":
        st.subheader("📈 漲幅排行")
        col1, col2 = st.columns(2)
        with col1:
            count = st.slider("筆數", 5, 50, 10)
        with col2:
            st.info(f"取前 {count} 檔")
        if st.button("查詢", key="ranking_up"):
            with st.spinner("查詢中..."):
                result = qw.query_ranking("up", count)
                st.session_state.current_result = result
                display_result(result, "漲幅排行")

    elif query_type == "跌幅排行":
        st.subheader("📉 跌幅排行")
        col1, col2 = st.columns(2)
        with col1:
            count = st.slider("筆數", 5, 50, 10)
        with col2:
            st.info(f"取後 {count} 檔")
        if st.button("查詢", key="ranking_down"):
            with st.spinner("查詢中..."):
                result = qw.query_ranking("down", count)
                st.session_state.current_result = result
                display_result(result, "跌幅排行")

    elif query_type == "成交量排行":
        st.subheader("📊 成交量排行")
        count = st.slider("筆數", 5, 50, 10)
        if st.button("查詢", key="ranking_volume"):
            with st.spinner("查詢中..."):
                result = qw.query_ranking("volume", count)
                st.session_state.current_result = result
                display_result(result, "成交量排行")

    elif query_type == "成交金額排行":
        st.subheader("💰 成交金額排行")
        count = st.slider("筆數", 5, 50, 10)
        if st.button("查詢", key="ranking_amount"):
            with st.spinner("查詢中..."):
                result = qw.query_ranking("amount", count)
                st.session_state.current_result = result
                display_result(result, "成交金額排行")

    elif query_type == "個股即時快照":
        st.subheader("📊 個股即時快照")
        codes = code_input_section("輸入股票代號", single=False)
        if st.button("查詢", key="snapshot"):
            if codes:
                with st.spinner("查詢中..."):
                    result = qw.query_snapshot(codes)
                    st.session_state.current_result = result
                    display_result(result, "個股即時快照")
            else:
                st.warning("請輸入至少一個股票代號")

    elif query_type == "個股日K":
        st.subheader("📈 個股日K")
        code = code_input_section("輸入股票代號")
        start_date, end_date = date_input_section()
        if st.button("查詢", key="kbar"):
            if code:
                with st.spinner("查詢中..."):
                    result = qw.query_daily_kbar(code, start_date, end_date)
                    st.session_state.current_result = result
                    display_result(result, f"{code} 日K")
            else:
                st.warning("請輸入股票代號")

    elif query_type == "逐筆成交":
        st.subheader("📝 逐筆成交")
        code = code_input_section("輸入股票代號")
        query_date = st.date_input("選擇日期", date.today())
        if st.button("查詢", key="ticks"):
            if code:
                with st.spinner("查詢中..."):
                    result = qw.query_ticks(code, query_date)
                    st.session_state.current_result = result
                    display_result(result, f"{code} 逐筆成交")
            else:
                st.warning("請輸入股票代號")

def render_account():
    """帳務查詢"""
    main_logger.info("渲染帳務 Tab")
    st.warning("⚠️ 帳務功能需要 CA 憑證，模擬環境受限")

    query_type = st.selectbox(
        "選擇查詢類型",
        [
            "庫存未實現損益",
            "已實現損益",
            "帳戶餘額",
            "交易額度",
            "期貨保證金",
            "交割款明細"
        ]
    )

    if query_type == "庫存未實現損益":
        st.subheader("📊 庫存未實現損益")
        st.info("查詢持有股票的未實現損益")
        if st.button("查詢庫存", key="positions"):
            with st.spinner("查詢中..."):
                try:
                    result = qw.query_positions("stock")
                    st.session_state.current_result = result
                    if not result.empty:
                        display_result(result, "庫存未實現損益")
                        add_history({
                            "tab": "帳務",
                            "title": "庫存未實現損益",
                            "params": {"type": "positions"}
                        })
                    else:
                        st.info("無持股資料")
                except Exception as e:
                    st.error(f"查詢失敗: {str(e)}")

    elif query_type == "已實現損益":
        st.subheader("💰 已實現損益")
        start_date, end_date = date_input_section(default_days=90)
        if st.button("查詢損益", key="profit_loss"):
            with st.spinner("查詢中..."):
                try:
                    result = qw.query_profit_loss(start_date, end_date)
                    st.session_state.current_result = result
                    if not result.empty:
                        display_result(result, f"已實現損益 ({start_date} ~ {end_date})")
                        add_history({
                            "tab": "帳務",
                            "title": "已實現損益",
                            "params": {"type": "profit_loss", "start": str(start_date), "end": str(end_date)}
                        })
                    else:
                        st.info("查詢期間無損益記錄")
                except Exception as e:
                    st.error(f"查詢失敗: {str(e)}")

    elif query_type == "帳戶餘額":
        st.subheader("💳 帳戶餘額")
        st.info("查詢帳戶現金及可用額度")
        if st.button("查詢餘額", key="account_balance"):
            with st.spinner("查詢中..."):
                try:
                    result = qw.query_account_balance()
                    st.session_state.current_result = result
                    if result is not None:
                        display_result(result, "帳戶餘額")
                        add_history({
                            "tab": "帳務",
                            "title": "帳戶餘額",
                            "params": {"type": "account_balance"}
                        })
                    else:
                        st.info("無餘額資料")
                except Exception as e:
                    st.error(f"查詢失敗: {str(e)}")

    elif query_type == "交易額度":
        st.subheader("📈 交易額度")
        st.info("查詢可用的交易額度")
        if st.button("查詢額度", key="trading_limits"):
            with st.spinner("查詢中..."):
                try:
                    result = qw.query_trading_limits()
                    st.session_state.current_result = result
                    if result is not None:
                        display_result(result, "交易額度")
                        add_history({
                            "tab": "帳務",
                            "title": "交易額度",
                            "params": {"type": "trading_limits"}
                        })
                    else:
                        st.info("無額度資料")
                except Exception as e:
                    st.error(f"查詢失敗: {str(e)}")

    elif query_type == "期貨保證金":
        st.subheader("📊 期貨保證金")
        st.info("查詢期貨保證金使用情況")
        if st.button("查詢保證金", key="margin"):
            with st.spinner("查詢中..."):
